[resource]
script = ExtResource("map_definition")
definition_id = &"final_decision"
grid_size = Vector2i(1024, 768)
player_spawn_cell = Vector2i(64, 704)
enemy_spawn_cell = Vector2i(959, 63)
camera_start_cell = Vector2i(64, 704)
require_central_symmetry = true
main_lane_width_cells = 32
side_lane_width_cells = 10
lanes = Array[ExtResource("map_lane_definition")]([SubResource("top"), SubResource("mid"), SubResource("bottom")])
supply_points = Array[ExtResource("map_supply_point_definition")]([SubResource("blue_base"), SubResource("red_base"), SubResource("blue_top_high"), SubResource("red_bottom_high"), SubResource("blue_top_inner"), SubResource("red_bottom_inner"), SubResource("blue_top_outer"), SubResource("red_bottom_outer"), SubResource("blue_mid_high"), SubResource("red_mid_high"), SubResource("blue_mid_inner"), SubResource("red_mid_inner"), SubResource("blue_mid_outer"), SubResource("red_mid_outer"), SubResource("blue_bottom_high"), SubResource("red_top_high"), SubResource("blue_bottom_inner"), SubResource("red_top_inner"), SubResource("blue_bottom_outer"), SubResource("red_top_outer"), SubResource("jungle_upper_rear"), SubResource("jungle_lower_rear"), SubResource("jungle_upper_major"), SubResource("jungle_lower_major"), SubResource("jungle_upper_forward"), SubResource("jungle_lower_forward")])
wild_regions = Array[ExtResource("map_wild_region_definition")]([SubResource("wild_upper_rear"), SubResource("wild_lower_rear"), SubResource("wild_upper_major"), SubResource("wild_lower_major"), SubResource("wild_upper_forward"), SubResource("wild_lower_forward")])
connectors = Array[ExtResource("map_connector_definition")]([SubResource("upper_rear"), SubResource("lower_rear"), SubResource("upper_major"), SubResource("lower_major"), SubResource("upper_forward"), SubResource("lower_forward"), SubResource("river"), SubResource("upper_river_link"), SubResource("lower_river_link")])
